#!/bin/sh
# Migrate configuration from Podkop, the project Okop is derived from.
# Runs on every install and upgrade of okop, so /etc/config/podkop is moved away once handled:
# otherwise every later upgrade would copy it over the okop configuration again.

PODKOP_CONFIG=/etc/config/podkop
PODKOP_CONFIG_DONE=/etc/podkop.migrated

[ -f "$PODKOP_CONFIG" ] || exit 0

# Podkop may have left dnsmasq reconfigured without restoring it.
# Move its backup under Okop's keys so that Okop can restore dnsmasq later.
dnsmasq_backup_found=0
for key in server noresolv cachesize; do
    value="$(uci -q get "dhcp.@dnsmasq[0].podkop_$key")"
    [ -n "$value" ] || continue

    dnsmasq_backup_found=1
    uci -q delete "dhcp.@dnsmasq[0].okop_$key"
    if [ "$key" = "server" ]; then
        for server in $value; do
            uci add_list "dhcp.@dnsmasq[0].okop_server=$server"
        done
    else
        uci set "dhcp.@dnsmasq[0].okop_$key=$value"
    fi
    uci -q delete "dhcp.@dnsmasq[0].podkop_$key"
done

if [ "$dnsmasq_backup_found" -eq 1 ]; then
    uci set "dhcp.@dnsmasq[0].okop_switched=1"
    uci commit dhcp
fi

if [ "$(uci -q get okop.settings.migrated_from_podkop)" = "1" ]; then
    logger -t "okop" "Configuration was already migrated from Podkop, $PODKOP_CONFIG is kept as $PODKOP_CONFIG_DONE"
elif [ "$(uci -q get podkop.settings)" != "settings" ]; then
    # Podkop before 0.7 kept everything in a "main" section without "settings", a different layout
    logger -t "okop" "$PODKOP_CONFIG is from Podkop before 0.7 and cannot be migrated, configure okop anew. It is kept as $PODKOP_CONFIG_DONE"
else
    cp "$PODKOP_CONFIG" /etc/config/okop
    uci set okop.settings.migrated_from_podkop='1'
    uci commit okop
    logger -t "okop" "Configuration migrated from $PODKOP_CONFIG, the original is kept as $PODKOP_CONFIG_DONE"
fi

mv "$PODKOP_CONFIG" "$PODKOP_CONFIG_DONE"

exit 0
