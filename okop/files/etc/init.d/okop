#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC2154

START=99
# Stopped on shutdown, so a clean reboot gives dnsmasq back before the next boot: services that start
# before okop (S99) and need DNS, such as VPN endpoints given by host name, would otherwise wait for it
STOP=10
USE_PROCD=1

script=$(readlink "$initscript")
NAME="$(basename ${script:-$initscript})"
config_load "$NAME"

start_service() {
    # default_postinst runs "start" on every package upgrade, also for a disabled okop. Nothing would
    # stop it again before a reboot, and after the reboot dnsmasq would still point at sing-box with
    # no okop to give it back.
    if [ "$PKG_UPGRADE" = "1" ] && ! enabled; then
        echo "okop is disabled, not starting it after the upgrade"
        return 0
    fi

    echo "Start okop"

    config_get enable_badwan_interface_monitoring "settings" "enable_badwan_interface_monitoring"
    config_get badwan_monitored_interfaces "settings" "badwan_monitored_interfaces"

    procd_open_instance
    procd_set_param command /usr/bin/okop start
    [ "$enable_badwan_interface_monitoring" = "1" ] && [ -n "$badwan_monitored_interfaces" ] &&
        procd_set_param netdev "$badwan_monitored_interfaces"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/okop stop
}

# The "Disable" button in LuCI Diagnostics calls this. Only removing the rc.d links left dnsmasq
# forwarding to sing-box, whose autostart okop also disables, so after a reboot nothing restored the
# user's DNS settings and the whole LAN stopped resolving.
disable() {
    "$initscript" stop

    local name
    name="$(basename "$initscript")"
    rm -f "$IPKG_INSTROOT"/etc/rc.d/S??"$name"
    rm -f "$IPKG_INSTROOT"/etc/rc.d/K??"$name"
}

reload_service() {
    /usr/bin/okop reload > /dev/null 2>&1
}

service_triggers() {
    echo "service_triggers start"

    config_get enable_badwan_interface_monitoring "settings" "enable_badwan_interface_monitoring"
    config_get badwan_monitored_interfaces "settings" "badwan_monitored_interfaces"
    config_get badwan_reload_delay "settings" "badwan_reload_delay" "2000"

    PROCD_RELOAD_DELAY=$badwan_reload_delay

    procd_open_trigger
    procd_add_config_trigger "config.change" "$NAME" "$initscript" restart

    if [ "$enable_badwan_interface_monitoring" = "1" ]; then
        for iface in $badwan_monitored_interfaces; do
            procd_add_interface_trigger "interface.*.up" "$iface" /etc/init.d/okop reload
        done
    fi
    procd_close_trigger
}
