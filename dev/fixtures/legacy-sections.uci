# The layout of okop 0.6 and earlier: connections inside sections. Converted to connections on start.
config settings 'settings'
	option dns_type 'udp'
	# Not 1.1.1.1: UDP/53 to it is blackholed on some Docker hosts, which made DNS flaky
	option dns_server '77.88.8.8'
	option bootstrap_dns_server '77.88.8.8'
	option dns_rewrite_ttl '60'
	list source_network_interfaces 'br-lan'
	option enable_output_network_interface '0'
	option enable_badwan_interface_monitoring '0'
	option enable_yacd '0'
	option disable_quic '0'
	option update_interval '1d'
	option download_lists_via_proxy '1'
	option download_lists_via_proxy_section 'main'
	option dont_touch_dhcp '0'
	option config_path '/etc/sing-box/config.json'
	option cache_path '/tmp/sing-box/cache.db'
	option log_level 'info'
	option exclude_ntp '0'

config section 'main'
	option connection_type 'proxy'
	option proxy_config_type 'url'
	option proxy_string 'ss://YWVzLTEyOC1nY206b2tvcC1kZXY=@172.31.77.3:8388#dev-proxy'
	option enable_udp_over_tcp '0'
	option mixed_proxy_enabled '1'
	option mixed_proxy_port '2080'
	list community_lists 'youtube'
	option user_domain_list_type 'dynamic'
	list user_domains 'example.com'

config section 'multi'
	option connection_type 'proxy'
	option proxy_config_type 'urltest'
	list urltest_proxy_links 'ss://YWVzLTEyOC1nY206b2tvcC1kZXY=@172.31.77.3:8388#dev-proxy'
	list urltest_proxy_links 'ss://YWVzLTEyOC1nY206b2tvcC1kZXY=@172.31.77.3:8388#dev-proxy-2'
	option urltest_check_interval '1m'
	option urltest_tolerance '100'
	option user_domain_list_type 'dynamic'
	list user_domains 'wikipedia.org'

config section 'vpn'
	option connection_type 'vpn'
	option interface 'wg0'
	option domain_resolver_enabled '1'
	option domain_resolver_dns_type 'udp'
	option domain_resolver_dns_server '8.8.8.8'
	option user_domain_list_type 'dynamic'
	list user_domains 'kernel.org'

config section 'blk'
	option connection_type 'block'
	option user_domain_list_type 'dynamic'
	list user_domains 'blocked.test'
